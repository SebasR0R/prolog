% reglas compuestas
libro_economico(Titulo) :-
    libro(Titulo,_),
    precio(Titulo,Precio),
    Precio < 300.

escrito_por(Titulo,Autor) :-
    libro(Titulo,Autor),
    genero(Titulo,_).

libros_rango_precio(Titulo,Precio,Min,Max) :-
    libro(Titulo,_),
    precio(Titulo,Precio),
    Precio >= Min,
    Precio =< Max.

libros_por_genero(Titulo,Genero) :-
    libro(Titulo,_),
    genero(Titulo,Genero).
